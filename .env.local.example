# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Gmail account the contact form sends from (must match the App Password below).
GMAIL_EMAIL=dasoftwaresystems@gmail.com

# Gmail App Password — NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first).
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Inbox that receives new inquiries. Defaults to GMAIL_EMAIL if unset —
# only set this if you want notifications to land somewhere other than the
# sending account.
CONTACT_TO_EMAIL=dasoftwaresystems@gmail.com

# Your deployed site origin, used for the API route's CORS header.
# Falls back to "*" if unset, which is fine for local development.
SITE_URL=https://dasoftwaresystems.web.app
